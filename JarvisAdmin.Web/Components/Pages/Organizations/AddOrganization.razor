            <label class="mb-0">Have Aftercare Programs</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.TeamRegPmtReqd" TValue="bool" Name="chkTeamRegPmtReqd" />
            <label class="mb-0">Require Payment for Team Registration</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.CoachApplications" TValue="bool" Name="chkCoachApplications" />
            <label class="mb-0">Coach Applications</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.VolunteerApplications" TValue="bool" Name="chkVolunteerApplications" />
            <label class="mb-0">Volunteer Applications</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.UseGrantFunding" TValue="bool" Name="chkUseGrantFunding" />
            <label class="mb-0">Use Grant Funding</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.OfferScholarships" TValue="bool" Name="chkOfferScholarships" />
            <label class="mb-0">Offer Scholarships</label>
        </div>
        <div class="col-md-6">
            <label class="form-label d-block">Background Check URL</label>
            <RadzenTextBox @bind-Value="_model.BackgroundCheckUrl" MaxLength="100" class="w-100" />
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.UseMembershipSystem" TValue="bool" Name="chkUseMembershipSystem" />
            <label class="mb-0">Use Membership System</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.UseSeasonPassSystem" TValue="bool" Name="chkUseSeasonPassSystem" />
            <label class="mb-0">Use Season Pass System</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.OnlineSeasonPass" TValue="bool" Name="chkOnlineSeasonPass" />
            <label class="mb-0">Online Season Pass</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.SeasonPassAccount" TValue="bool" Name="chkSeasonPassAccount" />
            <label class="mb-0">Season Pass Account</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.OnlineReserveFacilities" TValue="bool" Name="chkOnlineReserveFacilities" />
            <label class="mb-0">Online Reserve Facilities</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.UseShifts" TValue="bool" Name="chkUseShifts" />
            <label class="mb-0">Use Shifts</label>
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">Shift Location Type</label>
            <RadzenDropDown TValue="string" Data="@_shiftLocationTypeOptions" AllowClear="true"
                @bind-Value="_model.ShiftLocationType" class="w-100" />
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.AutoReopenFields" TValue="bool" Name="chkAutoReopenFields" />
            <label class="mb-0">Auto Reopen Fields</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.ShiftAutoendMidnight" TValue="bool" Name="chkShiftAutoendMidnight" />
            <label class="mb-0">Shift Auto-End at Midnight</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.RevenueCodeRequired" TValue="bool" Name="chkRevenueCodeRequired" />
            <label class="mb-0">Revenue Code Required</label>
        </div>
