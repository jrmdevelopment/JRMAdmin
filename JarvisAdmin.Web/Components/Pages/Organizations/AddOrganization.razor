@page "/organizations/add"
@using JarvisAdmin.Web.Data.Jarvis
@using JarvisAdmin.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject OrganizationService OrgService

<PageTitle>Add Organization - Jarvis Admin</PageTitle>

<h1>Add Organization</h1>
<p class="text-muted">Create a new organization. Fields marked <span class="text-danger">*</span> are required.</p>

@if (_successMessage is not null)
{
    <div class="alert alert-success" role="alert">@_successMessage</div>
}
@if (_error is not null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

<RadzenFieldset Text="Organization and Contact Information" class="mb-3">
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label d-block">Organization Name <span class="text-danger">*</span></label>
            <RadzenTextBox @bind-Value="_model.OrganizationName" MaxLength="50" class="w-100" />
        </div>
        <div class="col-md-2">
            <label class="form-label d-block">Status</label>
            <RadzenDropDown TValue="string" Data="@_statusOptions" TextProperty="Text" ValueProperty="Value"
                @bind-Value="_model.Status" class="w-100" />
        </div>
        <div class="col-md-6">
            <label class="form-label d-block">Address <span class="text-danger">*</span></label>
            <RadzenTextBox @bind-Value="_model.OrganizationAddr" MaxLength="50" class="w-100" />
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">City <span class="text-danger">*</span></label>
            <RadzenTextBox @bind-Value="_model.OrganizationCity" MaxLength="30" class="w-100" />
        </div>
        <div class="col-md-1">
            <label class="form-label d-block">State <span class="text-danger">*</span></label>
            <RadzenTextBox @bind-Value="_model.OrganizationSt" MaxLength="2" class="w-100" />
        </div>
        <div class="col-md-2">
            <label class="form-label d-block">Zip <span class="text-danger">*</span></label>
            <RadzenTextBox @bind-Value="_model.OrganizationZip" MaxLength="10" class="w-100" />
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">Contact Name <span class="text-danger">*</span></label>
            <RadzenTextBox @bind-Value="_model.ContactName" MaxLength="30" class="w-100" />
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">Contact Phone <span class="text-danger">*</span></label>
            <RadzenTextBox @bind-Value="_model.ContactPhone" MaxLength="12" class="w-100" />
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">Contact Email <span class="text-danger">*</span></label>
            <RadzenTextBox @bind-Value="_model.ContactEmailAddr" MaxLength="50" class="w-100" />
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">After-Hours Phone</label>
            <RadzenTextBox @bind-Value="_model.AfterhoursPhone" MaxLength="12" class="w-100" />
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2 pt-4">
            <RadzenCheckBox @bind-Value="_model.RequirePhysicalAddr" TValue="bool" Name="chkRequirePhysicalAddr" />
            <label class="mb-0">Require Physical Address</label>
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">Name For Lookup</label>
            <RadzenTextBox @bind-Value="_model.NameForLookup" MaxLength="50" class="w-100" />
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">Domain Name</label>
            <RadzenTextBox @bind-Value="_model.DomainName" MaxLength="50" class="w-100" />
        </div>
        <div class="col-md-2">
            <label class="form-label d-block">Time Zone</label>
            <RadzenDropDown TValue="int" Data="@_timeZoneOptions" TextProperty="Text" ValueProperty="Value"
                @bind-Value="_model.TimeZone" class="w-100" />
        </div>
        <div class="col-md-2">
            <label class="form-label d-block">Tax ID</label>
            <RadzenTextBox @bind-Value="_model.TaxId" MaxLength="20" class="w-100" />
        </div>
        <div class="col-md-2">
            <label class="form-label d-block">Standings Type <span class="text-danger">*</span></label>
            <RadzenTextBox @bind-Value="_model.StandingsType" MaxLength="6" class="w-100" />
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">POS Screen Name</label>
            <RadzenTextBox @bind-Value="_model.PosscreenName" MaxLength="30" class="w-100" />
        </div>
        <div class="col-12">
            <label class="form-label d-block">Internal Notes (Jarvis Comments)</label>
            <RadzenTextArea @bind-Value="_model.JarvisComments" Rows="3" class="w-100" />
        </div>
    </div>
</RadzenFieldset>

<RadzenFieldset Text="Email &amp; Notifications" class="mb-3">
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label d-block">From Email Address</label>
            <RadzenTextBox @bind-Value="_model.FromEmailAddress" MaxLength="50" class="w-100" />
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">From Email Password</label>
            <RadzenPassword @bind-Value="_model.FromEmailPw" MaxLength="20" class="w-100" />
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">Report Email</label>
            <RadzenTextBox @bind-Value="_model.ReportEmail" MaxLength="50" class="w-100" />
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">Report Phone</label>
            <RadzenTextBox @bind-Value="_model.ReportPhone" MaxLength="12" class="w-100" />
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">Game Time Text Notification (minutes before)</label>
            <RadzenNumeric TValue="int?" @bind-Value="_model.GameTimeTextNotificationMinutes" class="w-100" />
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">Practice Time Text Notification (minutes before)</label>
            <RadzenNumeric TValue="int?" @bind-Value="_model.PracticeTimeTextNotificationMinutes" class="w-100" />
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">Facility Reservation Text Notification (minutes before)</label>
            <RadzenNumeric TValue="int?" @bind-Value="_model.FacilityResvTextNotificationMinutes" class="w-100" />
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">Facility Reservation Invoice Reminder (days)</label>
            <RadzenNumeric TValue="int?" @bind-Value="_model.FacilityResvNbrDaysInvoiceReminder" class="w-100" />
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.TextGameReminders" TValue="bool" Name="chkTextGameReminders" />
            <label class="mb-0">Text Game Reminders</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.TextPracticeReminders" TValue="bool" Name="chkTextPracticeReminders" />
            <label class="mb-0">Text Practice Reminders</label>
        </div>
    </div>
</RadzenFieldset>

<RadzenFieldset Text="Registration Settings" class="mb-3">
    <div class="row g-3">
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.RequirePaymentWhenRegistering" TValue="bool" Name="chkRequirePaymentWhenRegistering" />
            <label class="mb-0">Require Payment When Registering</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.RestrictUnpaidRegistrants" TValue="bool" Name="chkRestrictUnpaidRegistrants" />
            <label class="mb-0">Restrict Unpaid Registrants</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.RequireParticipantMiddleName" TValue="bool" Name="chkRequireParticipantMiddleName" />
            <label class="mb-0">Require Participant Middle Name</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.OnlineApplications" TValue="bool" Name="chkOnlineApplications" />
            <label class="mb-0">Online Applications</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.OnlinePracticeApproval" TValue="bool" Name="chkOnlinePracticeApproval" />
            <label class="mb-0">Online Practice Approval</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.OnlineFacilityApproval" TValue="bool" Name="chkOnlineFacilityApproval" />
            <label class="mb-0">Online Facility Approval</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.ExternalTeamPractice" TValue="bool" Name="chkExternalTeamPractice" />
            <label class="mb-0">External Team Practice</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.ValidateResidencyByAddr" TValue="bool" Name="chkValidateResidencyByAddr" />
            <label class="mb-0">Validate Residency By Address</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.ValidateResidencyByZip" TValue="bool" Name="chkValidateResidencyByZip" />
            <label class="mb-0">Validate Residency By Zip</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.MedicalReleaseScreen" TValue="bool" Name="chkMedicalReleaseScreen" />
            <label class="mb-0">Medical Release Screen</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.UseDocumentManager" TValue="bool" Name="chkUseDocumentManager" />
            <label class="mb-0">Use Document Manager</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.MilitaryDiscount" TValue="bool" Name="chkMilitaryDiscount" />
            <label class="mb-0">Military Discount</label>
        </div>
    </div>
</RadzenFieldset>

<RadzenFieldset Text="Programs &amp; Modules" class="mb-3">
