</RadzenFieldset>

<RadzenFieldset Text="Billing Settings" class="mb-3">
    <div class="row g-3">
        <div class="col-md-2">
            <label class="form-label d-block">Fee Structure <span class="text-danger">*</span></label>
            <RadzenTextBox @bind-Value="_model.FeeStructure" MaxLength="10" class="w-100" />
        </div>
        <div class="col-md-2">
            <label class="form-label d-block">Monthly Billed Amount</label>
            <RadzenNumeric TValue="decimal" @bind-Value="_model.MonthlyBilledAmount" class="w-100" />
        </div>
        <div class="col-md-2">
            <label class="form-label d-block">League Mgmt Price</label>
            <RadzenNumeric TValue="decimal" @bind-Value="_model.LeagueMgmtPrice" class="w-100" />
        </div>
        <div class="col-md-2">
            <label class="form-label d-block">Activity Price</label>
            <RadzenNumeric TValue="decimal" @bind-Value="_model.ActivityPrice" class="w-100" />
        </div>
        <div class="col-md-2">
            <label class="form-label d-block">Team Price</label>
            <RadzenNumeric TValue="decimal" @bind-Value="_model.TeamPrice" class="w-100" />
        </div>
        <div class="col-md-2">
            <label class="form-label d-block">Payment Gateway</label>
            <RadzenDropDown TValue="string" Data="@_gatewayOptions" TextProperty="Text" ValueProperty="Value"
                @bind-Value="_model.GatewayUsed" class="w-100" />
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.SwipeMachine" TValue="bool" Name="chkSwipeMachine" />
            <label class="mb-0">Swipe Machine</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.UseEmvterminal" TValue="bool" Name="chkUseEmvterminal" />
            <label class="mb-0">Use EMV Terminal</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.AllowAmex" TValue="bool" Name="chkAllowAmex" />
            <label class="mb-0">Allow American Express</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.AllowDisc" TValue="bool" Name="chkAllowDisc" />
            <label class="mb-0">Allow Discover</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.PayOnline" TValue="bool" Name="chkPayOnline" />
            <label class="mb-0">Allow Online Payment</label>
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">Merchant % to Registrant</label>
            <RadzenNumeric TValue="decimal?" @bind-Value="_model.MerchantPctToRegistrant" class="w-100" />
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">Swipe % to Registrant</label>
            <RadzenNumeric TValue="decimal?" @bind-Value="_model.SwipePctToRegistrant" class="w-100" />
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">Minimum Convenience Fee</label>
            <RadzenNumeric TValue="decimal?" @bind-Value="_model.MinimumConvenienceFee" class="w-100" />
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">Membership Fee Type</label>
            <RadzenDropDown TValue="string" Data="@_membershipFlatOrPercentOptions" AllowClear="true"
                @bind-Value="_model.MembershipFlatOrPercent" class="w-100" />
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">Membership Flat Rate</label>
            <RadzenNumeric TValue="decimal?" @bind-Value="_model.MembershipFlatRate" class="w-100" />
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">Daily Percentage</label>
            <RadzenNumeric TValue="decimal?" @bind-Value="_model.DailyPercentage" class="w-100" />
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">Membership Percent Rate</label>
            <RadzenNumeric TValue="decimal?" @bind-Value="_model.MembershipPctRate" class="w-100" />
        </div>
    </div>
</RadzenFieldset>

<RadzenFieldset Text="Tax &amp; Finance" class="mb-3">
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label d-block">Facility Sales Tax %</label>
            <RadzenNumeric TValue="decimal?" @bind-Value="_model.FacilitySalesTax" class="w-100" />
