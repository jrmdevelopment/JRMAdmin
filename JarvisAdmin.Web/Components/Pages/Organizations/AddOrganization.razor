            <RadzenCheckBox @bind-Value="_model.TylerFinanceSystem" TValue="bool" Name="chkTylerFinanceSystem" />
            <label class="mb-0">Tyler Finance System</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.CaselleFinanceSystem" TValue="bool" Name="chkCaselleFinanceSystem" />
            <label class="mb-0">Caselle Finance System</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.FeedCashChecks" TValue="bool" Name="chkFeedCashChecks" />
            <label class="mb-0">Feed Cash/Checks</label>
        </div>
        <div class="col-md-3 d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="_model.BatchCashChecks" TValue="bool" Name="chkBatchCashChecks" />
