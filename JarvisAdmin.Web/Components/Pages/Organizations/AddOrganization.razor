        </div>
    </div>
</RadzenFieldset>

<RadzenFieldset Text="Documents &amp; Agreements" class="mb-3">
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label d-block">Fee Schedule File</label>
            <RadzenTextBox @bind-Value="_model.FeeScheduleFile" MaxLength="50" class="w-100" />
        </div>
        <div class="col-md-4">
            <label class="form-label d-block">Payment File</label>
            <RadzenTextBox @bind-Value="_model.PaymentFile" MaxLength="50" class="w-100" />
        </div>
        <div class="col-md-4">
            <label class="form-label d-block">Service Agreement File</label>
            <RadzenTextBox @bind-Value="_model.ServiceAgreementFile" MaxLength="50" class="w-100" />
        </div>
        <div class="col-md-4">
            <label class="form-label d-block">Editor CSS File</label>
            <RadzenTextBox @bind-Value="_model.EditorCssfile" MaxLength="20" class="w-100" />
        </div>
        <div class="col-md-4">
            <label class="form-label d-block">Image Editor Path</label>
            <RadzenTextBox @bind-Value="_model.ImageEditorPath" MaxLength="50" class="w-100" />
        </div>
        <div class="col-md-4">
            <label class="form-label d-block">Document Path</label>
            <RadzenTextBox @bind-Value="_model.DocumentPath" MaxLength="100" class="w-100" />
        </div>
        <div class="col-12">
            <label class="form-label d-block">Player Terms and Conditions</label>
            <RadzenTextArea @bind-Value="_model.PlayerTermsAndConditions" Rows="3" class="w-100" />
        </div>
        <div class="col-12">
            <label class="form-label d-block">Facility Rental Agreement</label>
            <RadzenTextArea @bind-Value="_model.FacilityRentalAgreement" Rows="3" class="w-100" />
        </div>
        <div class="col-12">
            <label class="form-label d-block">Facility Alcohol Agreement</label>
            <RadzenTextArea @bind-Value="_model.FacilityAlcoholAgreement" Rows="3" class="w-100" />
        </div>
        <div class="col-md-4">
            <label class="form-label d-block">Name of Acceptor</label>
            <RadzenTextBox @bind-Value="_model.NameOfAcceptor" MaxLength="30" class="w-100" />
        </div>
        <div class="col-md-4">
            <label class="form-label d-block">Username That Accepted Agreement</label>
            <RadzenTextBox @bind-Value="_model.UserNameAcceptAgreement" MaxLength="30" class="w-100" />
        </div>
        <div class="col-md-2 d-flex align-items-center gap-2 pt-4">
            <RadzenCheckBox @bind-Value="_model.Older18" TValue="bool" Name="chkOlder18" />
            <label class="mb-0">Acceptor Over 18</label>
        </div>
        <div class="col-md-2 d-flex align-items-center gap-2 pt-4">
            <RadzenCheckBox @bind-Value="_model.AcceptAgreement" TValue="bool" Name="chkAcceptAgreement" />
            <label class="mb-0">Agreement Accepted</label>
        </div>
    </div>
</RadzenFieldset>

<div class="d-flex gap-2 mb-4">
    <RadzenButton Text="Save Organization" ButtonStyle="ButtonStyle.Primary" Click="@SaveAsync" IsBusy="@_saving" />
    <RadzenButton Text="Reset" ButtonStyle="ButtonStyle.Light" Click="@ResetForm" Disabled="@_saving" />
</div>

@code {
    private sealed record TextOption(string Text, string Value);
    private sealed record TimeZoneOption(string Text, int Value);

    private static readonly List<TextOption> _statusOptions =
    [
        new("Active", "A"),
        new("Inactive", "I"),
    ];

    // TimeZone is an offset index used throughout the legacy Jarvis stored procedures
    // (1=Eastern, 2=Central, 3=Mountain, 4=Pacific), not a raw UTC offset.
    private static readonly List<TimeZoneOption> _timeZoneOptions =
    [
        new("Eastern", 1),
        new("Central", 2),
        new("Mountain", 3),
        new("Pacific", 4),
    ];

    private static readonly List<TextOption> _gatewayOptions =
    [
        new("AuthorizeNET", "AuthorizeNET"),
        new("MXGateway", "MXGateway"),
    ];

    private static readonly List<string> _shiftLocationTypeOptions = ["Single", "Multiple"];
    private static readonly List<string> _membershipFlatOrPercentOptions = ["Flat", "Percent"];

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Organization _model = OrganizationService.CreateNewOrganization();
    private bool _saving;
    private string? _error;
    private string? _successMessage;

    private async Task SaveAsync()
    {
        _error = null;
        _successMessage = null;

        if (string.IsNullOrWhiteSpace(_model.OrganizationName) ||
            string.IsNullOrWhiteSpace(_model.OrganizationAddr) ||
            string.IsNullOrWhiteSpace(_model.OrganizationCity) ||
            string.IsNullOrWhiteSpace(_model.OrganizationSt) ||
            string.IsNullOrWhiteSpace(_model.OrganizationZip) ||
            string.IsNullOrWhiteSpace(_model.ContactName) ||
            string.IsNullOrWhiteSpace(_model.ContactPhone) ||
            string.IsNullOrWhiteSpace(_model.ContactEmailAddr) ||
            string.IsNullOrWhiteSpace(_model.FeeStructure) ||
            string.IsNullOrWhiteSpace(_model.StandingsType))
        {
            _error = "Please fill in all required fields (marked *) before saving.";
            return;
        }

        _saving = true;

        string? currentUser = null;
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            currentUser = authState.User.Identity?.Name;
        }

        var created = await OrgService.AddOrganizationAsync(_model, currentUser);

        _successMessage = $"Organization \"{created.OrganizationName}\" created (Key: {created.OrganizationKey}).";
        _model = OrganizationService.CreateNewOrganization();

        _saving = false;
    }

    private void ResetForm()
    {
        _model = OrganizationService.CreateNewOrganization();
        _error = null;
        _successMessage = null;
    }
}
