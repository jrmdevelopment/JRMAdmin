@page "/organizations/add"
@using JarvisAdmin.Web.Data.Jarvis
@using JarvisAdmin.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject OrganizationService OrgService

<PageTitle>Add Organization - Jarvis Admin</PageTitle>

<div class="jarvis-page-header">
    <h1>Add Organization</h1>
    <p>Create a new organization. Fields marked <span class="text-danger">*</span> are required.</p>
</div>

<OrganizationForm Model="@_model" />

@* Only on Add: saved with the organization as its first user in the main Jarvis app (see AddOrganizationAsync). *@
<FormCard Title="Initial Login" Icon="key" Description="The first user for this organization. They're given the Administrator role with access to every screen.">
    <div class="row g-3">
        <div class="col-sm-6 col-lg-3">
            <label class="form-label d-block">Name <span class="text-danger">*</span></label>
            <RadzenTextBox @bind-Value="_login.Name" MaxLength="30" class="w-100" />
        </div>
        <div class="col-sm-6 col-lg-3">
            <label class="form-label d-block">Email <span class="text-danger">*</span></label>
            <RadzenTextBox @bind-Value="_login.Email" MaxLength="100" class="w-100" />
        </div>
        <div class="col-sm-6 col-lg-3">
            <label class="form-label d-block">User Id <span class="text-danger">*</span></label>
            <RadzenTextBox @bind-Value="_login.UserId" MaxLength="50" autocomplete="off" class="w-100" />
        </div>
        <div class="col-sm-6 col-lg-3">
            <label class="form-label d-block">Password <span class="text-danger">*</span> <HelpTip Text="@($"At least {InitialLogin.MinPasswordLength} characters.")" /></label>
            <RadzenPassword @bind-Value="_login.Password" autocomplete="new-password" class="w-100" />
        </div>
    </div>
</FormCard>

@* Pinned to the bottom of the screen, so the save result shows right where Save was clicked. *@
<div class="jarvis-form-actions">
    <RadzenButton Text="Save Organization" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="@SaveAsync" IsBusy="@_saving" />
    <RadzenButton Text="Reset" ButtonStyle="ButtonStyle.Light" Click="@ResetForm" Disabled="@_saving" />
    @if (_successMessage is not null)
    {
        <span class="jarvis-form-message is-success" role="status">@_successMessage</span>
    }
    @if (_error is not null)
    {
        <span class="jarvis-form-message is-error" role="alert">@_error</span>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Organization _model = OrganizationService.CreateNewOrganization();
    private InitialLogin _login = new();
    private bool _saving;
    private string? _error;
    private string? _successMessage;

    private async Task SaveAsync()
    {
        _error = null;
        _successMessage = null;

        if (!OrganizationService.HasRequiredFields(_model))
        {
            _error = "Please fill in all required fields (marked *) before saving.";
            return;
        }

        if (OrganizationService.FormatAndValidatePhones(_model) is { } phoneError)
        {
            _error = phoneError;
            return;
        }

        if (_login.Validate() is { } loginError)
        {
            _error = loginError;
            return;
        }

        _saving = true;
        try
        {
            string? currentUser = null;
            if (AuthStateTask is not null)
            {
                var authState = await AuthStateTask;
                currentUser = authState.User.Identity?.Name;
            }

            var created = await OrgService.AddOrganizationAsync(_model, _login, currentUser);

            _successMessage = $"Organization \"{created.OrganizationName}\" created (Key: {created.OrganizationKey}) with initial login \"{_login.UserId.Trim()}\".";
            _model = OrganizationService.CreateNewOrganization();
            _login = new();
        }
        catch (Exception ex)
        {
            // Keep what was typed so it can be corrected and saved again.
            _error = $"The organization could not be saved: {ex.GetBaseException().Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private void ResetForm()
    {
        _model = OrganizationService.CreateNewOrganization();
        _login = new();
        _error = null;
        _successMessage = null;
    }
}
