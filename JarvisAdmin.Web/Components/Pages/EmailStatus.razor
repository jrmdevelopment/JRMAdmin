@page "/emailstatus"
@using JarvisAdmin.Web.Services
@inject EmailStatusService EmailStatusService

<PageTitle>Email Status - Jarvis Admin</PageTitle>

<h1>Email Status</h1>
<p class="text-muted">Sent emails that have not yet received a delivery status from SendGrid.</p>

<div class="row g-3 align-items-end mb-3">
    <div class="col-auto">
        <RadzenButton Text="Update Send Status" Click="@UpdateStatusAsync" ButtonStyle="ButtonStyle.Primary" IsBusy="@_updating" />
    </div>
</div>

@if (_resultMessage is not null)
{
    <p class="@(_resultIsError ? "text-danger" : "text-success")">@_resultMessage</p>
}

<RadzenDataGrid Data="@_rows" TItem="EmailStatusRow" AllowSorting="true" AllowFiltering="true"
    AllowPaging="true" PageSize="25" PageSizeOptions="@(new[] { 25, 50, 100 })"
    IsLoading="@_loading" EmptyText="No emails without a status found.">
    <Columns>
        <RadzenDataGridColumn TItem="EmailStatusRow" Property="OrganizationName" Title="Organization" />
        <RadzenDataGridColumn TItem="EmailStatusRow" Property="EmailAddressSent" Title="Email Address" />
        <RadzenDataGridColumn TItem="EmailStatusRow" Property="EmailSubject" Title="Subject" />
        <RadzenDataGridColumn TItem="EmailStatusRow" Property="DateSent" Title="Date Sent" FormatString="{0:MM/dd/yyyy h:mm tt}" />
    </Columns>
</RadzenDataGrid>

@code {
    private List<EmailStatusRow> _rows = [];
    private bool _loading;
    private bool _updating;
    private string? _resultMessage;
    private bool _resultIsError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _rows = await EmailStatusService.GetEmailsWithNoStatusAsync();
        _loading = false;
    }

    private async Task UpdateStatusAsync()
    {
        _updating = true;
        _resultMessage = null;

        var result = await EmailStatusService.UpdateSendStatusAsync();

        if (result.Error is not null)
        {
            _resultMessage = result.Error;
            _resultIsError = true;
        }
        else
        {
            _resultMessage = $"Updated {result.Updated} email(s). {result.NotFound} had no matching SendGrid activity yet."
                + (result.RateLimited > 0 ? $" {result.RateLimited} were rate-limited by SendGrid and will be retried on the next update." : "");
            _resultIsError = false;
        }

        await LoadAsync();
        _updating = false;

        if (result.Error is null && _rows.Count > 0)
            _resultMessage += $" {_rows.Count} still remaining - click Update again to continue.";
    }
}
