@* An on/off setting shown as a switch tile; the whole tile (switch and label) is one clickable button.
   Usage: <ToggleField Label="Use Shifts" @bind-Value="Model.UseShifts" Help="..." /> *@

<div class="jarvis-toggle-tile @(Disabled ? "is-disabled" : null)">
    <button type="button" class="jarvis-toggle" role="switch" aria-checked="@(Value ? "true" : "false")"
            disabled="@Disabled" @onclick="ToggleAsync">
        <span class="jarvis-toggle-track" aria-hidden="true"><span class="jarvis-toggle-thumb"></span></span>
        <span class="jarvis-toggle-label">@Label</span>
    </button>
    @if (!string.IsNullOrEmpty(Help))
    {
        <HelpTip Text="@Help" />
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string? Help { get; set; }

    [Parameter]
    public bool Value { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private Task ToggleAsync() => ValueChanged.InvokeAsync(!Value);
}
